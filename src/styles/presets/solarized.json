{
  "id": "builtin-solarized",
  "name": "Solarized",
  "builtin": true,
  "typography": {
    "bodyFont": "'Segoe UI Variable Text', 'Segoe UI', system-ui, sans-serif",
    "headingFont": "'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, 'Cascadia Mono', monospace",
    "monoFont": "'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, 'Cascadia Mono', monospace",
    "baseSize": 16,
    "lineHeight": 1.55,
    "contentWidth": 800,
    "paragraphSpacing": 1,
    "headingWeight": 700
  },
  "headingScale": [1.7, 1.35, 1.15, 1.05, 1, 0.9],
  "colors": {
    "light": {
      "bg": "#fdf6e3",
      "text": "#264d59",
      "heading": "#073642",
      "link": "#2074af",
      "muted": "#325d6c",
      "border": "#e0d5b2",
      "codeBg": "#eee8d5",
      "codeText": "#126aa9",
      "quoteBorder": "#2aa198",
      "quoteText": "#5e737a",
      "tableBorder": "#e4ddc8",
      "tableStripe": "#f7f0dc",
      "hr": "#e0d5b2"
    },
    "dark": {
      "bg": "#002b36",
      "text": "#becaca",
      "heading": "#eee8d5",
      "link": "#3295da",
      "muted": "#99a7a8",
      "border": "#094251",
      "codeBg": "#073642",
      "codeText": "#4aa2de",
      "quoteBorder": "#2aa198",
      "quoteText": "#839496",
      "tableBorder": "#0d4452",
      "tableStripe": "#04313c",
      "hr": "#094251"
    }
  },
  "customCss": "/* Solarized: Ethan Schoonover's palette; light and dark share the same accents */\n"
}
